# Everything is optional for local use. `npm run dev` works with none of these set.

# Anthropic key (you can paste it in Settings instead)
ANTHROPIC_API_KEY=

# Database: unset = embedded PGlite in ./data. Set to a Neon/Postgres URL when hosting.
DATABASE_URL=
# PGLITE_DIR=./data/pglite

# Encrypts stored API keys. Required when DATABASE_URL is set; auto-generated locally otherwise.
APP_SECRET=

# Inngest: the dev server needs nothing. In production set these from Inngest Cloud (or a self-hosted server URL).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# INNGEST_DEV=1
# INNGEST_BASE_URL=http://localhost:8288

# Maintainers / hosted only
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloud mode (milestone 8)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
